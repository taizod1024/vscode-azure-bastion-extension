{
  "version": "0.1.3",
  "name": "azure-bastion",
  "displayName": "Azure Bastion Extension",
  "description": "A VS Code extension for Azure Bastion",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-azuretools.vscode-azureresourcegroups"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "azure",
    "bastion",
    "ssh"
  ],
  "publisher": "taizod1024",
  "main": "./build/main.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "azure-bastion.invokeAZNetWork",
        "title": "Open Resources"
      },
      {
        "command": "azure-bastion.refreshResources",
        "title": "Refresh Resources",
        "icon": "$(refresh)"
      },
      {
        "command": "azure-bastion.refreshNode",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "azure-bastion.signIn",
        "title": "Sign in to Azure"
      },
      {
        "command": "azure-bastion.connectVmTunnel",
        "title": "Connect via Tunnel",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "azure-bastion.connectVmSsh",
        "title": "Connect via SSH",
        "icon": "$(terminal)"
      },
      {
        "command": "azure-bastion.connectVmRdp",
        "title": "Connect via RDP",
        "icon": "$(vm)"
      },
      {
        "command": "azure-bastion.configureVm",
        "title": "Configure VM"
      },
      {
        "command": "azure-bastion.openSshConfig",
        "title": "Open SSH Config",
        "icon": "$(go-to-file)"
      },
      {
        "command": "azure-bastion.viewProperties",
        "title": "View Properties"
      },
      {
        "command": "azure-bastion.openInPortal",
        "title": "Open in Portal",
        "icon": "$(globe)"
      },
      {
        "command": "azure-bastion.openInPortalExternal",
        "title": "Open in Portal with External Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "azure-bastion.focusExplorer",
        "title": "Open Resources"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azureBastion",
          "title": "Azure Bastion",
          "icon": "$(debug-disconnect)"
        }
      ]
    },
    "views": {
      "azureBastion": [
        {
          "id": "azureBastion.resources",
          "name": "Azure Resources",
          "icon": "$(debug-disconnect)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "azure-bastion.invokeAZNetWork",
          "when": "false"
        },
        {
          "command": "azure-bastion.refreshResources",
          "when": "false"
        },
        {
          "command": "azure-bastion.signIn",
          "when": "false"
        },
        {
          "command": "azure-bastion.focusExplorer",
          "when": "false"
        },
        {
          "command": "azure-bastion.connectVmTunnel",
          "when": "false"
        },
        {
          "command": "azure-bastion.connectVmSsh",
          "when": "false"
        },
        {
          "command": "azure-bastion.connectVmRdp",
          "when": "false"
        },
        {
          "command": "azure-bastion.configureVm",
          "when": "false"
        },
        {
          "command": "azure-bastion.viewProperties",
          "when": "false"
        },
        {
          "command": "azure-bastion.openInPortal",
          "when": "false"
        },
        {
          "command": "azure-bastion.openInPortalExternal",
          "when": "false"
        },
        {
          "command": "azure-bastion.refreshNode",
          "when": "false"
        },
        {
          "command": "azure-bastion.openSshConfig",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "azure-bastion.openSshConfig",
          "when": "view == azureBastion.resources",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "azure-bastion.connectVmTunnel",
          "when": "view == azureBastion.resources && (viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "inline@1"
        },
        {
          "command": "azure-bastion.connectVmSsh",
          "when": "view == azureBastion.resources && (viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "inline@2"
        },
        {
          "command": "azure-bastion.connectVmRdp",
          "when": "view == azureBastion.resources && viewItem == azureBastionVmWindows",
          "group": "inline@3"
        },
        {
          "command": "azure-bastion.openInPortal",
          "when": "view == azureBastion.resources && (viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "inline@4"
        },
        {
          "command": "azure-bastion.openInPortalExternal",
          "when": "view == azureBastion.resources && (viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "inline@5"
        },
        {
          "command": "azure-bastion.refreshNode",
          "when": "view == azureBastion.resources && (viewItem == azureBastionRoot || viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "inline@6"
        },
        {
          "command": "azure-bastion.connectVmTunnel",
          "when": "view == azureBastion.resources && (viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "0_connect@1"
        },
        {
          "command": "azure-bastion.connectVmSsh",
          "when": "view == azureBastion.resources && (viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "0_connect@2"
        },
        {
          "command": "azure-bastion.connectVmRdp",
          "when": "view == azureBastion.resources && viewItem == azureBastionVmWindows",
          "group": "0_connect@3"
        },
        {
          "command": "azure-bastion.configureVm",
          "when": "view == azureBastion.resources && (viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "1_configure"
        },
        {
          "command": "azure-bastion.viewProperties",
          "when": "view == azureBastion.resources && (viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "2_resource@1"
        },
        {
          "command": "azure-bastion.openInPortal",
          "when": "view == azureBastion.resources && (viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "2_resource@2"
        },
        {
          "command": "azure-bastion.openInPortalExternal",
          "when": "view == azureBastion.resources && (viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "2_resource@3"
        },
        {
          "command": "azure-bastion.refreshNode",
          "when": "view == azureBastion.resources && (viewItem == azureBastionRoot || viewItem == azureBastionSubscription || viewItem == azureBastionVmWindows || viewItem == azureBastionVmOther)",
          "group": "2_resource@4"
        }
      ]
    },
    "keybindings": []
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=build/main.js --format=cjs --platform=node --external:vscode --external:child_process",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test": "node ./build/test/runTest.js",
    "vscode:uninstall": "node bin/uninstall.js",
    "release": "npm run release-premerge && npx standard-version && vsce publish && npm run release-postmerge",
    "release-premerge": "git switch main && git merge --no-ff develop --no-edit",
    "release-postmerge": "git push --follow-tags origin main && git push origin develop && git switch develop",
    "package": "vsce package",
    "clean": "rmdir /q /s .\\build || exit /b 0"
  },
  "author": "yamamoto.taizo <taizod1024@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^13.2.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.11.1",
    "@types/superagent": "^4.1.13",
    "@types/superagent-proxy": "^2.0.1",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "bufferutil": "^4.0.5",
    "esbuild": "^0.27.2",
    "eslint": "^8.0.1",
    "generator-code": "^1.6.2",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0",
    "ts-node": "^10.3.0",
    "typescript": "^4.4.4",
    "utf-8-validate": "^5.0.7",
    "vscode": "^0.9.9",
    "vscode-test": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taizod1024/vscode-azure-bastion-extension.git"
  },
  "dependencies": {
    "child_process": "^1.0.2",
    "iconv-lite": "^0.6.3"
  }
}
